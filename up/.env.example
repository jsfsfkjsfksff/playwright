# 服务
INTERNAL_TOKEN=change-me
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 配置文件路径
PROVIDERS_FILE=configs/providers.yaml
MODEL_ROUTING_FILE=configs/model_routing.yaml
VOICES_FILE=configs/voices.yaml

# LLM 通用参数
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# TTS（音色取值见百炼「Qwen-Audio-TTS 音色列表」，不是 Azure 的 zh-CN-xxx 命名）
TTS_DEFAULT_VOICE=longanhuan_v3.1
TTS_DEFAULT_RATE=1.0
TTS_TIMEOUT=60
# 批量合成并发上限（一次生成几十幕时，防止把 DashScope 打限流）
TTS_MAX_CONCURRENCY=4
DASHSCOPE_TTS_BASE_URL=
DASHSCOPE_TTS_MODEL=qwen-audio-3.1-tts-flash

# Agent
AGENT_DEFAULT_MODEL_ALIAS=podcaster

# ---- 密钥：本文件入库，一律留占位；真实值写到 .env（已被 .gitignore 忽略）----
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_TTS_API_KEY=
ALIYUN_MAAS_API_KEY=

# Qwen-Audio-TTS：走「业务空间」专属域名，形如
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
